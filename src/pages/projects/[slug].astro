---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectGallery from '../../components/ProjectGallery.astro';
import { siteConfig, withBase } from '../../config';
import { getVisibleProjects, type Project } from '../../lib/projects';

export function getStaticPaths() {
  const projects = getVisibleProjects();

  return projects.map((project, index) => {
    const previousProject =
      projects.length > 1 ? projects[(index - 1 + projects.length) % projects.length] : undefined;
    const nextProject =
      projects.length > 1 ? projects[(index + 1) % projects.length] : undefined;

    return {
      params: { slug: project.slug },
      props: { project, previousProject, nextProject },
    };
  });
}

interface Props {
  project: Project;
  previousProject?: Project;
  nextProject?: Project;
}

const { project, previousProject, nextProject } = Astro.props;
const DescriptionContent = project.DescriptionContent;
---

<BaseLayout
  title={`${project.data.title} — ${siteConfig.title}`}
  description={project.data.description || `${project.data.title} project.`}
>
  <a class="project-back" href={withBase('/?restore=projects')}>Back to Projects</a>

  {previousProject && nextProject && (
    <nav class="project-sequence" aria-label="Browse projects">
      <a
        class="project-sequence__link project-sequence__link--previous"
        href={withBase(`/projects/${previousProject.slug}/`)}
        aria-label={`Previous project: ${previousProject.data.title}`}
        title={previousProject.data.title}
      >
        <span aria-hidden="true">←</span>
      </a>
      <a
        class="project-sequence__link project-sequence__link--next"
        href={withBase(`/projects/${nextProject.slug}/`)}
        aria-label={`Next project: ${nextProject.data.title}`}
        title={nextProject.data.title}
      >
        <span aria-hidden="true">→</span>
      </a>
    </nav>
  )}

  <article class="project-page">
    <ProjectGallery images={project.images} projectTitle={project.data.title} />

    <header class="project-page__header">
      <div>
        <h1>{project.data.title}</h1>
        {project.data.description && (
          project.renderMarkdownDescription ? (
            <div class="project-page__description"><DescriptionContent /></div>
          ) : (
            <p class="project-page__description">{project.data.description}</p>
          )
        )}
      </div>
      <dl class="project-page__meta">
        <div><dt>Disciplines</dt><dd>{project.data.disciplines.join(', ')}</dd></div>
        <div><dt>Year</dt><dd>{project.data.year}</dd></div>
        <div><dt>Company</dt><dd>{project.data.company}</dd></div>
        {project.data.tools && project.data.tools.length > 0 && (
          <div><dt>Tools Used</dt><dd>{project.data.tools.join(', ')}</dd></div>
        )}
      </dl>
    </header>
  </article>
</BaseLayout>
